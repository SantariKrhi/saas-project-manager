# Copier en .env pour personnaliser (optionnel : des valeurs par défaut existent dans compose.yml)

# Connexion MongoDB : seule variable à changer pour passer en replica set / sharding (Partie II)
# Exemple replica set : mongodb://m1:27017,m2:27017,m3:27017/saas?replicaSet=rs0&w=majority
# Exemple sharding    : mongodb://mongos:27017/saas
MONGO_URI=mongodb://mongo:27017/saas
MONGO_DB=saas

JWT_SECRET=change-me-in-production
# Conservation du journal d'activité en jours (index TTL MongoDB)
ACTIVITY_TTL_DAYS=90

PORT=3000
APP_PORT=3000
